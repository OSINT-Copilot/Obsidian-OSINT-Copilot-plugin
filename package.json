{
  "name": "osint-copilot",
  "version": "2.5.6",
  "description": "OSINT Copilot for Obsidian - AI-powered Q&A and Report Generation",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "app:build": "node esbuild.config.mjs app production",
    "app:dev": "node esbuild.config.mjs app watch",
    "app": "npm run app:build && node scripts/launch-app.mjs",
    "app:smoke": "npm run app:build && node scripts/launch-app.mjs --smoke",
    "generate:schemas": "node scripts/generate-oidsf-schemas.cjs",
    "build": "npm run generate:schemas && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:run": "vitest run",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "ai",
    "llm",
    "osint",
    "threat-intelligence",
    "soc"
  ],
  "author": "Probe Point Analytics",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@testing-library/dom": "^10.4.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.19.32",
    "@typescript-eslint/parser": "^8.53.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.19.8",
    "eslint": "^9.39.2",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^17.0.0",
    "jsdom": "^28.0.0",
    "obsidian": "^1.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "cytoscape": "3.28.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "leaflet": "1.9.4",
    "lucide-static": "^1.39.0",
    "markdown-it": "^15.0.1",
    "pdfjs-dist": "4.5.136",
    "yaml": "^2.8.3"
  }
}
