{
  "name": "osint-copilot",
  "version": "3.0.0",
  "description": "OSINT Copilot - a local-first investigation workspace for SOC analysts and threat researchers",
  "main": "dist-app/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "app:build": "node esbuild.config.mjs app production",
    "app:dev": "node esbuild.config.mjs app watch",
    "app": "npm run app:build && node scripts/launch-app.mjs",
    "app:smoke": "npm run app:build && node scripts/launch-app.mjs --smoke",
    "dist": "npm run app:build && electron-builder --publish never",
    "dist:dir": "npm run app:build && electron-builder --dir --publish never",
    "generate:schemas": "node scripts/generate-oidsf-schemas.cjs",
    "build": "npm run generate:schemas && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:run": "vitest run",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "ai",
    "llm",
    "osint",
    "threat-intelligence",
    "soc"
  ],
  "author": "Probe Point Analytics",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@testing-library/dom": "^10.4.1",
    "@types/diff": "^7.0.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.32",
    "@typescript-eslint/parser": "^8.53.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.19.8",
    "eslint": "^9.39.2",
    "eslint-formatter-compact": "^9.0.1",
    "globals": "^17.0.0",
    "jsdom": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@lezer/highlight": "^1.2.3",
    "chokidar": "^5.0.0",
    "cytoscape": "3.28.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "leaflet": "1.9.4",
    "lucide-static": "^1.39.0",
    "markdown-it": "^15.0.1",
    "pdfjs-dist": "4.5.136",
    "yaml": "^2.8.3"
  },
  "build": {
    "appId": "com.probepoint.osint-copilot",
    "productName": "OSINT Copilot",
    "copyright": "Copyright (c) Probe Point Analytics",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-app/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/chokidar/**/*",
      "node_modules/readdirp/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/pdfjs-dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Probe Point Analytics"
    },
    "afterSign": "build/notarize.cjs",
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ]
  }
}
